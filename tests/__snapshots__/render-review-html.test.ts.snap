exports[`renderReviewHtml > renders the document with margin notes for every comment state (golden) 1`] = `"<div class="legal-review"><style>.legal-review{display:flex;align-items:flex-start;gap:24px;color:#111111;}.legal-review .legal-review__doc{flex:1 1 auto;min-width:0;}.legal-review .legal-review__notes{flex:0 0 220px;font-family:sans-serif;font-size:12px;line-height:1.4;}.legal-review .legal-review__title{font-weight:bold;margin-bottom:8px;}.legal-review .legal-review__empty{font-style:italic;color:#666666;}.legal-review .legal-review__list{list-style:none;margin:0;padding:0;}.legal-review .review-note{border-left:3px solid #f0b429;background:#fffbea;padding:6px 8px;margin-bottom:8px;}.legal-review .review-note--resolved{border-left-color:#a0aec0;background:#f7fafc;opacity:0.6;}.legal-review .review-note--orphaned{border-left-color:#e53e3e;background:#fff5f5;}.legal-review .review-note--stale{border-left-style:dashed;}.legal-review .review-note__meta{color:#888888;font-size:11px;margin-bottom:2px;}.legal-review .review-note__quote{margin:0 0 4px;padding:0;font-style:italic;color:#666666;}.legal-review .review-note__text{white-space:pre-wrap;}.legal-review .review-note__flags{margin-top:4px;}.legal-review .review-note__flag{display:inline-block;margin-right:4px;padding:0 4px;border-radius:2px;background:#00000014;font-size:10px;text-transform:uppercase;}@media print{.legal-review .legal-review__notes{display:none;}}</style><div class="legal-review__doc"><div class="legal-doc"><style>.legal-doc{color:#111111;font-family:"LegalDocs Serif",Georgia,"Times New Roman",serif;font-size:11px;}.legal-doc .title{font-size:18px;font-weight:bold;margin:0 0 16px;text-align:left;}.legal-doc p{margin:0 0 8px 0px;text-align:left;text-indent:0px;}.legal-doc .article{margin-bottom:6px;}.legal-doc .article[data-level="2"],.legal-doc .article[data-level="3"]{margin-left:14px;}.legal-doc .article__heading{font-weight:bold;margin-bottom:8px;}.legal-doc .article[data-level="1"]>.article__heading{font-size:13px;}.legal-doc .article[data-level="2"]>.article__heading{font-size:12px;}.legal-doc .article[data-level="3"]>.article__heading{font-size:11px;}.legal-doc .list{margin:0 0 4px 14px;}.legal-doc .list--alpha{list-style-type:lower-alpha;}.legal-doc .party{margin-bottom:8px;}.legal-doc .party__role{font-weight:bold;font-size:11px;}.legal-doc .kv{border-collapse:collapse;border-top:1px solid #999999;margin-bottom:8px;}.legal-doc .kv th,.legal-doc .kv td{border-bottom:1px solid #999999;padding:4px;font-size:10px;text-align:left;vertical-align:top;}.legal-doc .kv th{width:140px;}.legal-doc .signatures{display:flex;gap:24px;margin-top:16px;}.legal-doc .sig{flex:1;}.legal-doc .sig__line{border-top:1px solid #111111;margin-top:28px;margin-bottom:4px;}.legal-doc .sig__name{font-size:10px;}.legal-doc .sig__role{font-size:10px;color:#555555;}.legal-doc .legal-doc__unsupported{color:#b00020;font-style:italic;}</style><h1 class="title" data-path="/body/0">PLEDGE AGREEMENT</h1><p data-path="/body/1">The price is 120 CZK.</p><section class="article" data-level="1" data-path="/body/2"><div class="article__heading">1 Definitions</div><p data-path="/body/2/body/0">As defined below.</p></section></div></div><aside class="legal-review__notes"><div class="legal-review__title">Comments</div><ol class="legal-review__list"><li class="review-note" data-comment="c1" data-path="/body/2"><div class="review-note__meta">jana · 2026-01-01T00:00:00.000Z</div><blockquote class="review-note__quote">1 Definitions</blockquote><div class="review-note__text">Add a definition of Price.</div></li><li class="review-note review-note--resolved" data-comment="c2" data-path="/body/0"><div class="review-note__meta">petr · 2026-01-01T00:00:00.000Z</div><blockquote class="review-note__quote">PLEDGE AGREEMENT</blockquote><div class="review-note__text">Title agreed with counsel.</div><div class="review-note__flags"><span class="review-note__flag">resolved</span></div></li><li class="review-note review-note--stale" data-comment="c3" data-path="/body/1"><div class="review-note__meta">jana · 2026-01-01T00:00:00.000Z</div><blockquote class="review-note__quote">The price is 100 CZK.</blockquote><div class="review-note__text">Check the price.</div><div class="review-note__flags"><span class="review-note__flag">outdated quote</span></div></li><li class="review-note review-note--orphaned" data-comment="c4"><div class="review-note__meta">jana · 2026-01-01T00:00:00.000Z</div><blockquote class="review-note__quote">First bullet.</blockquote><div class="review-note__text">One more bullet?</div><div class="review-note__flags"><span class="review-note__flag">orphaned</span></div></li></ol></aside></div>"`;
