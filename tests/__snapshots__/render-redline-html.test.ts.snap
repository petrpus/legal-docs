// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderRedlineHtml > renders one change of every kind inline (golden) 1`] = `"<div class="legal-doc legal-redline legal-redline--inline"><style>.legal-doc{color:#111111;font-family:"LegalDocs Serif",Georgia,"Times New Roman",serif;font-size:11px;}.legal-doc .title{font-size:18px;font-weight:bold;margin:0 0 16px;text-align:left;}.legal-doc p{margin:0 0 8px 0px;text-align:left;text-indent:0px;}.legal-doc .article{margin-bottom:6px;}.legal-doc .article[data-level="2"],.legal-doc .article[data-level="3"]{margin-left:14px;}.legal-doc .article__heading{font-weight:bold;margin-bottom:8px;}.legal-doc .article[data-level="1"]>.article__heading{font-size:13px;}.legal-doc .article[data-level="2"]>.article__heading{font-size:12px;}.legal-doc .article[data-level="3"]>.article__heading{font-size:11px;}.legal-doc .list{margin:0 0 4px 14px;}.legal-doc .list--alpha{list-style-type:lower-alpha;}.legal-doc .party{margin-bottom:8px;}.legal-doc .party__role{font-weight:bold;font-size:11px;}.legal-doc .kv{border-collapse:collapse;border-top:1px solid #999999;margin-bottom:8px;}.legal-doc .kv th,.legal-doc .kv td{border-bottom:1px solid #999999;padding:4px;font-size:10px;text-align:left;vertical-align:top;}.legal-doc .kv th{width:140px;}.legal-doc .signatures{display:flex;gap:24px;margin-top:16px;}.legal-doc .sig{flex:1;}.legal-doc .sig__line{border-top:1px solid #111111;margin-top:28px;margin-bottom:4px;}.legal-doc .sig__name{font-size:10px;}.legal-doc .sig__role{font-size:10px;color:#555555;}.legal-doc .legal-doc__unsupported{color:#b00020;font-style:italic;}.legal-redline ins{background:#e6ffed;text-decoration:none;}.legal-redline del{background:#ffeef0;text-decoration:line-through;}.legal-redline .redline-block{border-left:3px solid transparent;padding-left:6px;}.legal-redline .redline-block--ins{border-left-color:#2da44e;background:#e6ffed;}.legal-redline .redline-block--del{border-left-color:#cf222e;background:#ffeef0;text-decoration:line-through;}.legal-redline .redline-block--attr{border-left-color:#9a6700;}.legal-redline .redline-item--ins{background:#e6ffed;}.legal-redline .redline-item--del{background:#ffeef0;text-decoration:line-through;}.legal-redline .redline-p--ins{background:#e6ffed;}.legal-redline .redline-p--del{background:#ffeef0;text-decoration:line-through;}.legal-redline .redline-note{display:block;font-family:sans-serif;font-size:10px;text-transform:uppercase;color:#57606a;}.legal-redline .redline-furniture{margin-top:16px;border-top:1px solid #d0d7de;padding-top:8px;font-family:sans-serif;font-size:9px;}.legal-redline .redline-furniture__title{font-weight:bold;margin-bottom:4px;}.legal-redline .redline-furniture__slot{display:inline-block;min-width:120px;color:#57606a;}</style><h1 class="title" style="text-align:center" data-path="/body/0">PLEDGE AGREEMENT</h1><p style="text-indent:12px;margin-left:0px" data-path="/body/1">Entered into on <del>1</del><ins>2</ins> <del>January</del><ins>February</ins> 2026.</p><div class="rich" data-path="/body/2"><p class="redline-p redline-p--edit">Plain <strong>bold</strong> and <del><em>italic</em></del><ins>rewritten.</ins></p></div><div class="party" data-path="/body/3"><div class="party__role">Pledgee</div><div class="party__name">Acme Bank <del>a.s.</del><ins>SE</ins></div><div>12345678</div><div>Prague</div></div><div class="party" data-path="/body/4"><div class="party__role">Pledgor</div><div class="party__name">Jane Doe</div></div><section class="article" data-level="1" data-path="/body/5"><div class="article__heading">1 Definitions<ins> and interpretation</ins></div><div class="redline-block redline-block--attr"><span class="redline-note">align: justify → center</span><p style="text-align:center" data-path="/body/5/body/0">Capitalised terms have the meanings given below.</p></div><div class="redline-block redline-block--del" data-base-path="/body/5/body/1"><section class="article" data-level="2"><div class="article__heading">1.1</div><p>A nested article with no heading.</p></section></div><ol class="list" data-path="/body/5/body/1"><li data-path="/body/5/body/1/items/0"><p data-path="/body/5/body/1/items/0/0">First numbered item.</p></li><li data-path="/body/5/body/1/items/1"><section class="article" data-level="2" data-path="/body/5/body/1/items/1/0"><div class="article__heading">1.2 Article inside a list item</div><p data-path="/body/5/body/1/items/1/0/body/0">Nested body.</p></section></li></ol><div class="redline-block redline-block--ins"><section class="article" data-level="2" data-path="/body/5/body/2"><div class="article__heading">1.1</div><p data-path="/body/5/body/2/body/0">A nested article with no heading.</p></section></div></section><ul class="list" data-path="/body/6"><li data-path="/body/6/items/0"><p data-path="/body/6/items/0/0">A bullet.</p></li><li class="redline-item redline-item--del" data-base-path="/body/6/items/1"><h1 class="title">A titled bullet.</h1></li></ul><div class="redline-block redline-block--ins"><p data-path="/body/7">A brand new recital.</p></div><ol class="list list--alpha" data-path="/body/8"><li data-path="/body/8/items/0"><p data-path="/body/8/items/0/0">Item (a).</p></li></ol><table class="kv" data-path="/body/9"><tbody><tr><th>Principal</th><td>1 000 000 CZK</td></tr><tr><th>Rate</th><td><del>4.5</del><ins>5.0</ins> %</td></tr></tbody></table><div class="redline-block redline-block--del" data-base-path="/body/9"><span class="qr">QR</span></div><div class="redline-block redline-block--ins"><div data-path="/body/10"><span class="qr">QR</span></div></div><div data-path="/body/11"><hr class="page-break"></div><div class="signatures" data-path="/body/12"><div class="sig"><div class="sig__line"></div><div class="sig__name">Acme Bank a.s.</div><div class="sig__role">Pledgee</div></div><div class="sig"><div class="sig__line"></div><div class="sig__name">Jane Doe</div><div class="sig__role"><ins>Pledgor</ins></div></div></div><div class="redline-furniture"><div class="redline-furniture__title">Page header and footer</div><div class="redline-furniture__row" data-path="/header/right"><span class="redline-furniture__slot">/header/right</span><del>Confidential</del><ins>Internal</ins></div></div></div>"`;
