{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    // Matches the Vite alias: the editing subpath is read from the built library's declarations. The
    // root entry is Node-only and is NOT aliased for the browser on purpose — only the tests (which
    // run under the repo-root vitest config) may import it, and a client that tries will fail loudly
    // at `vite build` with an unresolved import.
    "paths": {
      "@petrpus/legal-docs/edit": ["../../dist/edit.d.ts"],
      "@petrpus/legal-docs": ["../../dist/index.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
